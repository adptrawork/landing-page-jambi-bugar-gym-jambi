---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, coaches, ctaLink } from '../data/business';
---
<BaseLayout title="Pelatih Jambi Bugar Gym — Coach Sesi Pria & Muslimah" description="Pelatih Jambi Bugar Gym: coach sesi pria, coach sesi muslimah, pendamping transformasi. Nama coach aktual cek IG @jambibugar.gym." canonicalPath="/pelatih">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">Pelatih</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Coach yang paham kebutuhanmu</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Peran di bawah <strong>Estimasi</strong> — nama coach aktual cek postingan IG atau DM langsung.</p>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden">
          <img src="/images/jambi-bugar-3.jpg" alt="Coach mendampingi member latihan di Jambi Bugar Gym" width="800" height="600" loading="eager" class="w-full aspect-[4/3] object-cover" />
          <p class="p-5 text-sm text-stone-600">Sesi coaching — foto konteks, ganti foto asli. Sumber: Unsplash (bebas lisensi).</p>
        </div>
      </div>
    </div>
    <ol class="mt-10 bg-white border border-stone-200/70 rounded-[2.5rem] divide-y divide-stone-200/80 px-7 md:px-9">
      {coaches.map((c, i) => (
        <li class="flex items-start gap-5 py-6">
          <span class="grid place-items-center w-11 h-11 rounded-2xl bg-emerald-800/[0.07] text-emerald-800 shrink-0" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="128" cy="80" r="40"/><path d="M48 224c0-44 36-72 80-72s80 28 80 72"/></svg>
          </span>
          <div>
            <p class="font-mono-num text-xs text-emerald-800">0{i + 1} — {c.badge}</p>
            <p class="mt-1 font-semibold text-lg tracking-tight">{c.role}</p>
            <p class="mt-1 text-base text-stone-600">{c.desc}</p>
          </div>
        </li>
      ))}
    </ol>
    <a href={ctaLink(`Halo ${business.name}, saya pemula. Bisa dibantu coach saat pertama datang?`)} class="mt-8 inline-block bg-emerald-800 text-white px-8 py-3.5 rounded-full font-medium active:scale-[0.98]">Minta Didampingi Coach</a>
  </section>
</BaseLayout>
