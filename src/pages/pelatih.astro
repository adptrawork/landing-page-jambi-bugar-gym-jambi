---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CoachProfile from '../components/CoachProfile.astro';
import ContactRuled from '../components/ContactRuled.astro';
import ProgramSessions from '../components/ProgramSessions.astro';
import EduList from '../components/EduList.astro';
import ScheduleTable from '../components/ScheduleTable.astro';
import LocationSection from '../components/LocationSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, programs, coachNoe, adminContact, coachDirectoryNote, waLink } from '../data/business';

const waAdmin = waLink(adminContact.phone, `Halo admin ${business.name}, saya mau tanya jadwal pelatih & sesi.`);

const crumbTrail = [
  { name: 'Beranda', url: '/' },
  { name: 'Pelatih', url: '/pelatih' },
];

const facts = [
  { k: 'Pelatih utama', v: `${coachNoe.name} (${coachNoe.fullName})` },
  { k: 'Peran', v: 'Penggagas & pelatih berlisensi nasional' },
  { k: 'Pendekatan', v: 'Edukasi teknik sebelum menambah beban' },
  { k: 'Kontak', v: `${coachNoe.phone} (pelatih) · ${adminContact.phone} (admin)` },
];

const contacts = [
  { name: coachNoe.name, role: `${coachNoe.fullName} — ${coachNoe.role}`, phone: coachNoe.phone, wa: waLink(coachNoe.phone, `Assalamualaikum ${coachNoe.name}, saya mau tanya pendekatan latihan di ${business.name}.`), tag: 'Pelatih berlisensi' },
  { name: adminContact.name, role: adminContact.role, phone: adminContact.phone, wa: waAdmin, tag: 'Admin' },
];

const eduGroups = [
  { title: 'Prinsip latihan', items: [
    'Teknik benar lebih dulu; beban menyusul setelah gerakan stabil.',
    'Progres bertahap dan terukur, bukan kejutan beban di awal.',
    'Pemulihan dihitung sebagai bagian latihan, bukan kemalasan.',
  ] },
  { title: 'Cara mulai', items: [
    'Hubungi admin, sebutkan kamu memilih sesi pria atau sesi muslimah.',
    'Lakukan asesmen awal untuk mencatat kondisi dan target.',
    'Mulai sesi perdana dengan pendampingan coach.',
  ] },
  { title: 'Aturan sesi', items: [
    'Sesi pria dan sesi muslimah dijalankan terpisah.',
    'Hadir sesuai jadwal yang dikonfirmasi admin.',
    'Informasikan riwayat cedera atau kondisi kesehatan sebelum mulai.',
  ] },
];

const scheduleRows = [
  { name: 'Sesi latihan pria', audience: 'Pria', schedule: 'Hari & jam dikonfirmasi via admin' },
  { name: 'Sesi latihan muslimah', audience: 'Wanita', schedule: 'Hari & jam dikonfirmasi via admin' },
  { name: 'Pendampingan coach', audience: 'Semua level', schedule: 'Dengan janji temu bersama coach' },
];
---
<BaseLayout
  title="Pelatih & coach Jambi Bugar Gym — sesi pria & muslimah"
  description="Kenali Coach Noe (Muhammad Nor), pelatih berlisensi Jambi Bugar Gym, dan kontak admin jadwal sesi. Pendekatan edukatif, tanpa profil karangan."
  canonicalPath="/pelatih"
  image={coachNoe.img}
  breadcrumbs={crumbTrail}
>
  <PageHero
    eyebrow="Pelatih & pendampingan"
    title="Kami mengajar cara latihan, bukan menjual hasil instan"
    lead="Halaman ini menunjukkan siapa yang mendampingi latihanmu dan bagaimana cara menghubunginya. Kami hanya menampilkan profil yang benar-benar terverifikasi — bukan daftar nama hasil karangan."
    image="/images/jambi-bugar-5.jpg"
    imageAlt="Rak dumbel di area latihan Jambi Bugar Gym, tanpa orang"
    imageCaption="Alat latihan kekuatan — visual non-wajah"
    crumbs={crumbTrail}
    ctas={[
      { href: waAdmin, label: 'Tanya jadwal sesi', icon: 'whatsapp' },
      { href: '/program', label: 'Lihat program', variant: 'ghost' },
    ]}
    facts={facts}
  />

  <CoachProfile coach={coachNoe} />

  <ContactRuled
    heading="Kontak pelatih & admin"
    lead="Coach Noe untuk pertanyaan seputar pendekatan dan teknik latihan; Coach Iir (admin) untuk jadwal, pendaftaran, dan tarif."
    entries={contacts}
    note={coachDirectoryNote}
  />

  <ProgramSessions
    heading="Sesi yang didampingi pelatih"
    lead="Dua sesi berjalan dan terverifikasi dari kanal resmi; dua lainnya masih estimasi dan perlu konfirmasi admin."
    items={programs}
    ctaHref={waAdmin}
    ctaLabel="Tanya sesi ini"
    note="Tanda Estimasi berarti detailnya belum ada di sumber resmi — konfirmasi via admin sebelum mendaftar."
  />

  <EduList
    heading="Yang kami ajarkan sebelum angkat beban"
    lead="Materi edukasi dasar yang selalu disampaikan di awal, agar latihan aman dan berkelanjutan."
    groups={eduGroups}
  />

  <ScheduleTable
    heading="Jadwal sesi & pendampingan"
    lead="Jadwal mengikuti sesi pria/muslimah yang terpisah. Angka jam pasti dikonfirmasi admin."
    rows={scheduleRows}
    note="Catatan resmi gym: sesi pria/wanita terpisah, jadwal menyusul via kanal resmi. Konfirmasi tercepat lewat WhatsApp admin."
  />

  <LocationSection
    heading="Lokasi latihan"
    lead="Kota Jambi. Admin akan mengarahkan rute paling akurat sebelum kunjungan pertamamu."
  />

  <CtaBand
    heading="Ingin didampingi dari nol?"
    body="Sampaikan kondisi dan tujuanmu. Admin akan mengatur sesi perdana bersama Coach Noe."
    waHref={waAdmin}
    igUrl={business.instagram}
  />
</BaseLayout>
