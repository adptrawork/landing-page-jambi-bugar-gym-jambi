---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, ctaLink } from '../data/business';
const heroCta = ctaLink(`Halo ${business.name}, saya mau tanya jadwal sesi.`);
---
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[88dvh] py-10">
      <div class="md:col-span-7">
        <p class="flex items-center gap-2 text-sm font-medium text-emerald-700">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128 16l36 74 82 12-59 58 14 82-73-38-73 38 14-82-59-58 82-12z"/></svg>
          <span class="font-mono-num">{business.followers}</span>
          <span class="text-zinc-500">• Home Gym Islami • Jambi</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Jambi Bugar Gym — Rumah Transformasi yang Nyaman & Syari</h1>
        <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">Home gym islami: jadwal latihan terpisah pria/wanita, suasana aman untuk pemula. {business.hours}.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={heroCta} class="bg-emerald-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Minta Jadwal Sesi</a>
          <a href="/program" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium hover:border-zinc-950 active:scale-[0.98]">Lihat Program</a>
        </div>
        <div class="mt-8 flex divide-x divide-zinc-200 border-t border-zinc-200 pt-5 text-sm">
          <div class="pr-6"><p class="font-mono-num font-semibold">Pria/Wanita</p><p class="text-zinc-500">Sesi terpisah</p></div>
          <div class="px-6"><p class="font-mono-num font-semibold">Islami</p><p class="text-zinc-500">Nyaman & aman</p></div>
          <div class="pl-6"><p class="font-mono-num font-semibold">DM IG</p><p class="text-zinc-500">Pendaftaran</p></div>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <img src="/images/jambi-bugar-1.jpg" alt="Area beban home gym islami Jambi Bugar Gym sesi pria" width="800" height="600" loading="eager" fetchpriority="high" class="w-full aspect-[4/3] object-cover" />
          <div class="p-8">
            <p class="font-semibold text-lg tracking-tight">Latihan tenang, sesi terpisah</p>
            <p class="mt-1 text-base text-gray-600">Tidak campur — fokus latihan tanpa canggung. Cocok untuk pemula.</p>
          </div>
        </div>
        <p class="mt-3 text-xs text-zinc-400">Sumber: Unsplash (foto konteks area beban, bebas lisensi) — ganti foto asli gym.</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <img src="/images/jambi-bugar-2.jpg" alt="Kelas kebugaran sesi wanita di Jambi Bugar Gym" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
        <div class="p-8">
          <p class="font-semibold text-lg tracking-tight">Sesi pria & wanita terpisah</p>
          <p class="text-base text-gray-600">Konsep terverifikasi bio IG resmi. <a class="underline" href="/program">Lihat program</a>.</p>
        </div>
      </div></div>
      <div class="md:col-span-5"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <img src="/images/jambi-bugar-3.jpg" alt="Coach mendampingi member latihan di Jambi Bugar Gym" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
        <div class="p-8">
          <p class="font-semibold text-lg tracking-tight">Didampingi coach</p>
          <p class="text-base text-gray-600">Teknik benar sejak awal. <a class="underline" href="/pelatih">Kenalan dengan pelatih</a>.</p>
        </div>
      </div></div>
    </div>
    <p class="mt-3 text-xs text-zinc-400">Sumber: Unsplash (foto konteks kelas & coaching, bebas lisensi) — ganti foto asli gym.</p>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <p class="text-sm font-medium text-emerald-700">Lokasi</p>
        <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Tanya alamat via DM IG</h2>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">{business.address}. <a class="underline text-zinc-900" href="/kontak">Hubungi & rute</a> • <a class="underline text-zinc-900" href="/harga">Lihat harga</a></p>
      </div>
      <div class="md:col-span-7">
        <div class="rounded-[2.5rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
          <iframe title="Peta Jambi Bugar Gym" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
