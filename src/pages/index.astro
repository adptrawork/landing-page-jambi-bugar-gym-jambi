---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CoachProfile from '../components/CoachProfile.astro';
import ContactRuled from '../components/ContactRuled.astro';
import ProgramSessions from '../components/ProgramSessions.astro';
import EduList from '../components/EduList.astro';
import ScheduleTable from '../components/ScheduleTable.astro';
import LocationSection from '../components/LocationSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, programs, coachNoe, adminContact, coachDirectoryNote, waLink } from '../data/business';

const waAdmin = waLink(adminContact.phone, `Halo admin ${business.name}, saya mau tanya jadwal sesi & pendaftaran.`);

const facts = [
  { k: 'Sesi', v: 'Pria & muslimah dijalankan terpisah' },
  { k: 'Pendampingan', v: 'Coach & asesmen awal sebelum program' },
  { k: 'Suasana', v: 'Home gym yang tenang, bukan ajang pamer' },
  { k: 'Kontak', v: 'WhatsApp Coach Noe & admin' },
];

const contacts = [
  { name: coachNoe.name, role: coachNoe.role + ' — ' + coachNoe.fullName, phone: coachNoe.phone, wa: waLink(coachNoe.phone, `Assalamualaikum ${coachNoe.name}, saya mau tanya pendekatan latihan di ${business.name}.`), tag: 'Pelatih' },
  { name: adminContact.name, role: adminContact.role, phone: adminContact.phone, wa: waAdmin, tag: 'Admin' },
];

const eduGroups = [
  { title: 'Prinsip latihan', items: [
    'Mulai dari teknik yang benar, bukan beban yang berat.',
    'Naikkan beban atau repetisi sedikit demi sedikit setiap pekan.',
    'Sisipkan pemulihan — otot tumbuh saat istirahat, bukan saat dipaksa.',
  ] },
  { title: 'Cara mulai', items: [
    'Hubungi admin untuk memilih sesi pria atau sesi muslimah.',
    'Jalani asesmen awal: catat kondisi dan target yang realistis.',
    'Ikuti sesi perdana didampingi coach, lalu evaluasi tiap beberapa pekan.',
  ] },
  { title: 'Aturan sesi', items: [
    'Sesi pria dan sesi muslimah berjalan terpisah, sesuai bio resmi gym.',
    'Datang sesuai jadwal yang sudah dikonfirmasi admin.',
    'Sampaikan kondisi kesehatan atau cedera sebelum latihan dimulai.',
  ] },
];

const scheduleRows = [
  { name: 'Sesi latihan pria', audience: 'Pria', schedule: 'Hari & jam dikonfirmasi via admin (WhatsApp)' },
  { name: 'Sesi latihan muslimah', audience: 'Wanita', schedule: 'Hari & jam dikonfirmasi via admin (WhatsApp)' },
  { name: 'Asesmen & konsultasi', audience: 'Semua level', schedule: 'Dengan janji temu bersama admin' },
];
---
<BaseLayout title={business.title} description="Jambi Bugar Gym Jambi: home gym islami, sesi pria & muslimah terpisah, pendampingan coach dan asesmen awal. Jadwal & pendaftaran lewat DM IG admin." canonicalPath="/" image={business.ogImage}>
  <PageHero
    eyebrow="Home gym islami — Kota Jambi"
    title="Latihan yang dipahami, bukan sekadar diikuti"
    lead="Jambi Bugar Gym adalah rumah transformasi islami dengan sesi pria dan muslimah terpisah. Kami menekankan pemahaman cara latihan: teknik dasar, asesmen awal, dan pendampingan coach — bukan janji hasil instan."
    image="/images/jambi-bugar-1.webp"
    imageAlt="Rak dumbel di area beban Jambi Bugar Gym, tanpa orang"
    imageCaption="Area latihan kekuatan — visual non-wajah"
    ctas={[
      { href: waAdmin, label: 'Tanya via WhatsApp', icon: 'whatsapp' },
      { href: '/pelatih', label: 'Kenali pelatih', variant: 'ghost' },
    ]}
    facts={facts}
  />

  <CoachProfile coach={coachNoe} />

  <ContactRuled
    heading="Bicara langsung dengan pelatih atau admin"
    lead="Satu nomor untuk pendampingan latihan, satu nomor untuk jadwal dan pendaftaran. Semua pertanyaan awal tidak dikenakan biaya."
    entries={contacts}
    note={coachDirectoryNote}
  />

  <ProgramSessions
    heading="Empat sesi yang bisa kamu mulai"
    lead="Dua sesi sudah pasti berjalan dan terverifikasi dari kanal resmi; dua lainnya bersifat estimasi dan perlu dikonfirmasi via admin."
    items={programs}
    ctaHref={waAdmin}
    ctaLabel="Tanya jadwal sesi"
    note="Tanda Estimasi berarti detail sesi belum kami temukan di sumber resmi — konfirmasi via admin sebelum memutuskan."
  />

  <EduList
    heading="Belajar dulu, berlatih kemudian"
    lead="Kami percaya kebugaran dimulai dari pemahaman. Tiga hal ini yang selalu kami sampaikan ke anggota baru."
    groups={eduGroups}
  />

  <ScheduleTable
    heading="Jadwal menyesuaikan sesi, bukan sebaliknya"
    lead="Hari dan jam tiap sesi belum kami publikasikan sebagai angka tetap supaya tidak salah datang."
    rows={scheduleRows}
    note="Konfirmasi tercepat lewat WhatsApp admin. Catatan resmi gym: sesi pria/wanita terpisah, jadwal menyusul via kanal resmi."
  />

  <LocationSection
    heading="Datang, lihat suasananya lebih dulu"
    lead="Lokasi di Kota Jambi. Alamat dan rute paling akurat diarahkan langsung oleh admin."
  />

  <CtaBand
    heading="Mulai dari satu pertanyaan"
    body="Ceritakan kondisimu saat ini dan target yang masuk akal. Admin akan mengarahkan ke sesi yang paling sesuai."
    waHref={waAdmin}
    igUrl={business.instagram}
  />
</BaseLayout>
