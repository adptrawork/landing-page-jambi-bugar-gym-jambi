---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, prices, ctaLink } from '../data/business';
const heroCta = ctaLink(`Halo ${business.name}, saya mau tanya jadwal sesi.`);
const slotCta = (s: string) => ctaLink(`Halo ${business.name}, apakah slot ${s} masih tersedia?`);
const priaSlots = ['Slot Pagi', 'Slot Siang', 'Slot Sore', 'Slot Malam'];
const muslimahSlots = ['Slot Pagi', 'Slot Siang', 'Slot Sore', 'Slot Khusus'];
---
<BaseLayout title="Jambi Bugar Gym Jambi — Home Gym Islami, Sesi Pria & Muslimah Terpisah" description="Rumah transformasi islami di Jambi: latihan kekuatan sesi pria dan muslimah terpisah, pendampingan coach, suasana tenang. Jadwal & daftar via DM IG @jambibugar.gym." canonicalPath="/" image={business.ogImage}>
  <!-- HERO SPLIT -->
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center py-10 md:py-16">
      <div class="md:col-span-6">
        <p class="reveal inline-flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-emerald-800 border border-emerald-800/25 rounded-full px-4 py-1.5 bg-emerald-800/[0.05]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-800" aria-hidden="true"></span>
          {business.followers} &bull; Home Gym Islami
        </p>
        <h1 class="reveal d1 mt-5 text-4xl md:text-6xl tracking-tighter leading-[0.95] font-bold">Latihan yang tenang, sesi yang terjaga</h1>
        <p class="reveal d2 mt-5 text-base text-stone-600 leading-relaxed max-w-[65ch]">Jambi Bugar Gym adalah rumah transformasi: jadwal latihan terpisah pria dan muslimah, bimbingan teknik yang benar, dan suasana aman untuk pemula hingga senior. {business.hours}.</p>
        <div class="reveal d3 mt-8 flex flex-wrap gap-3">
          <a href={heroCta} class="bg-emerald-800 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-500 hover:bg-emerald-900 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.22,0.61,0.21,1)">Minta Jadwal Sesi</a>
          <a href="/program" class="border border-stone-300 px-7 py-3.5 rounded-full font-medium hover:border-emerald-800 hover:text-emerald-800 active:scale-[0.98]">Lihat Program</a>
        </div>
        <dl class="reveal d4 mt-8 flex divide-x divide-stone-200 border-t border-stone-200 pt-5 text-sm">
          <div><dt class="sr-only">Konsep sesi</dt><dd class="font-mono-num font-semibold text-emerald-800">Pria / Muslimah</dd><dd class="text-stone-500">Sesi terpisah</dd></div>
          <div><dt class="sr-only">Suasana</dt><dd class="font-mono-num font-semibold text-emerald-800">Tenang</dd><dd class="text-stone-500">Aman &amp; syari</dd></div>
          <div><dt class="sr-only">Pendaftaran</dt><dd class="font-mono-num font-semibold text-emerald-800">DM IG</dd><dd class="text-stone-500">@jambibugar.gym</dd></div>
        </dl>
      </div>
      <div class="md:col-span-6">
        <div class="reveal d2 lift bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <img src="/images/jambi-bugar-1.jpg" alt="Area beban home gym islami Jambi Bugar Gym sesi pria" width="800" height="600" loading="eager" fetchpriority="high" class="w-full aspect-[4/3] object-cover" />
          <div class="p-8">
            <p class="font-semibold text-lg tracking-tight">Fokus latihan tanpa canggung</p>
            <p class="mt-1 text-base text-stone-600">Tidak campur — setiap sesi punya waktunya sendiri. Cocok untuk yang baru mulai.</p>
          </div>
        </div>
        <p class="mt-3 text-xs text-stone-400">Foto konteks area beban (Unsplash, bebas lisensi) — ganti foto asli gym.</p>
      </div>
    </div>
  </section>

  <!-- CHROMA-GRID JADWAL -->
  <section class="max-w-7xl mx-auto px-4 py-10" aria-labelledby="jadwal">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <div class="md:col-span-7">
        <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">Jadwal sesi</p>
        <h2 id="jadwal" class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Pilih slot sesimu</h2>
      </div>
      <p class="md:col-span-5 text-base text-stone-600">Ilustrasi pembagian slot — jam pasti tiap sesi berubah. Ketuk slot untuk tanya ketersediaan via DM.</p>
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="dot-field rounded-[2.5rem] border border-stone-200/70 p-6 md:p-8">
        <div class="flex items-baseline justify-between">
          <h3 class="font-bold text-xl tracking-tight">Slot Pria</h3>
          <span class="font-mono-num text-xs text-emerald-800 border border-emerald-800/30 rounded-full px-3 py-1">04 slot</span>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3">
          {priaSlots.map((s, i) => (
            <a href={slotCta(s + ' Pria')} class={`slot-tile reveal d${i + 1} block bg-white/90 backdrop-blur border border-stone-300 rounded-3xl p-5 active:scale-[0.98]`}>
              <p class="font-mono-num text-xs text-stone-400">P.{i + 1}</p>
              <p class="mt-1 font-semibold">{s}</p>
              <p class="mt-1 text-xs text-stone-500">Tanya jam via DM</p>
            </a>
          ))}
        </div>
      </div>
      <div class="dot-field rounded-[2.5rem] border border-emerald-800/25 bg-emerald-800/[0.03] p-6 md:p-8">
        <div class="flex items-baseline justify-between">
          <h3 class="font-bold text-xl tracking-tight">Slot Muslimah</h3>
          <span class="font-mono-num text-xs text-white bg-emerald-800 rounded-full px-3 py-1">04 slot</span>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3">
          {muslimahSlots.map((s, i) => (
            <a href={slotCta(s + ' Muslimah')} class={`slot-tile reveal d${i + 1} block bg-white/90 backdrop-blur border border-emerald-800/25 rounded-3xl p-5 active:scale-[0.98]`}>
              <p class="font-mono-num text-xs text-emerald-800/70">M.{i + 1}</p>
              <p class="mt-1 font-semibold">{s}</p>
              <p class="mt-1 text-xs text-stone-500">Tanya jam via DM</p>
            </a>
          ))}
        </div>
      </div>
    </div>
    <p class="mt-3 text-xs text-stone-400">Jam sesi aktual mengikuti postingan IG @jambibugar.gym — selalu konfirmasi sebelum datang.</p>
  </section>

  <!-- PROGRAM RINGKAS -->
  <section class="max-w-7xl mx-auto px-4 py-10" aria-labelledby="program">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7">
        <div class="lift bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <img src="/images/jambi-bugar-2.jpg" alt="Kelas kebugaran sesi muslimah di Jambi Bugar Gym" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
          <div class="p-8">
            <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">Terverifikasi bio IG</p>
            <p class="mt-1 font-semibold text-lg tracking-tight">Sesi pria &amp; muslimah terpisah</p>
            <p class="text-base text-stone-600">Konsep inti rumah transformasi. <a class="underline underline-offset-4" href="/program">Lihat semua program</a>.</p>
          </div>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="lift bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <img src="/images/jambi-bugar-3.jpg" alt="Coach mendampingi member latihan di Jambi Bugar Gym" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
          <div class="p-8">
            <p class="font-semibold text-lg tracking-tight">Didampingi coach</p>
            <p class="text-base text-stone-600">Teknik benar sejak awal. <a class="underline underline-offset-4" href="/pelatih">Kenalan dengan pelatih</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HARGA COCKPIT LIST -->
  <section class="max-w-7xl mx-auto px-4 py-10" aria-labelledby="harga">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-4">
        <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">Harga</p>
        <h2 id="harga" class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Panel harga jujur</h2>
        <p class="mt-3 text-base text-stone-600">Semua angka <strong>Estimasi</strong> — price list resmi hanya via DM IG. <a class="underline underline-offset-4 text-stone-900" href="/harga">Rincian lengkap</a></p>
      </div>
      <div class="md:col-span-8">
        <ol class="bg-white border border-stone-200/70 rounded-[2.5rem] divide-y divide-stone-200/80 px-7 md:px-9 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          {prices.slice(0, 5).map((p, i) => (
            <li class="flex items-baseline gap-4 py-5">
              <span class="font-mono-num text-xs text-emerald-800 w-7 shrink-0">0{i + 1}</span>
              <div class="min-w-0 flex-1">
                <p class="font-semibold tracking-tight truncate">{p.name}</p>
                <p class="text-xs text-stone-500">{p.badge}</p>
              </div>
              <span class="font-mono-num font-semibold text-sm md:text-base whitespace-nowrap">{p.price}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- LOKASI -->
  <section class="max-w-7xl mx-auto px-4 py-10" aria-labelledby="lokasi">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-4">
        <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">Lokasi</p>
        <h2 id="lokasi" class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Tanya alamat via DM IG</h2>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">{business.address}. <a class="underline underline-offset-4 text-stone-900" href="/kontak">Hubungi &amp; rute</a></p>
      </div>
      <div class="md:col-span-8">
        <div class="rounded-[2.5rem] overflow-hidden border border-stone-200/70 aspect-video bg-stone-100">
          <iframe title="Peta Jambi Bugar Gym" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
