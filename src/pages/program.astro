---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProgramSessions from '../components/ProgramSessions.astro';
import EduList from '../components/EduList.astro';
import ScheduleTable from '../components/ScheduleTable.astro';
import LocationSection from '../components/LocationSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, programs, adminContact, waLink } from '../data/business';

const waAdmin = waLink(adminContact.phone, `Halo admin ${business.name}, saya mau tanya program & jadwal sesi.`);

const crumbTrail = [
  { name: 'Beranda', url: '/' },
  { name: 'Program', url: '/program' },
];

const facts = [
  { k: 'Sesi', v: 'Pria & muslimah terpisah' },
  { k: 'Level', v: 'Pemula hingga lanjutan, sesuai asesmen' },
  { k: 'Pendampingan', v: 'Coach di sesi perdana' },
  { k: 'Info', v: 'Jadwal tiap sesi via admin' },
];

const eduGroups = [
  { title: 'Urutan yang disarankan', items: [
    'Asesmen awal — catat kondisi, riwayat cedera, dan target.',
    'Latihan kekuatan dasar untuk membiasakan pola gerak.',
    'Pendampingan coach saat menaikkan beban atau volume.',
    'Evaluasi berkala dan penyesuaian program.',
  ] },
  { title: 'Yang perlu dibawa & disiapkan', items: [
    'Pakaian latihan yang nyaman dan menutup dengan baik.',
    'Air minum dan handuk pribadi.',
    'Informasi kondisi kesehatan bila sedang dalam pemulihan.',
  ] },
];

const scheduleRows = [
  { name: 'Sesi latihan pria', audience: 'Pria', schedule: 'Hari & jam dikonfirmasi via admin' },
  { name: 'Sesi latihan muslimah', audience: 'Wanita', schedule: 'Hari & jam dikonfirmasi via admin' },
  { name: 'Asesmen awal & target', audience: 'Semua level', schedule: 'Dijadwalkan bersama admin' },
];
---
<BaseLayout
  title="Program & Sesi Jambi Bugar — Pria, Muslimah, Asesmen"
  description="Program latihan Jambi Bugar Gym: sesi pria & muslimah terpisah, pendampingan coach, asesmen awal. Lihat urutan yang disarankan dan cara mendaftar via admin."
  canonicalPath="/program"
  image="/images/jambi-bugar-2.webp"
  breadcrumbs={crumbTrail}
>
  <PageHero
    eyebrow="Program & sesi"
    title="Program yang bertahap, sesuai kemampuanmu"
    lead="Tidak ada satu program untuk semua orang. Kami mulai dari asesmen, lalu menyusun langkah latihan yang realistis untuk kondisi dan tujuanmu."
    image="/images/jambi-bugar-2.webp"
    imageAlt="Ruang latihan berisi bola medicine dan dumbel, tanpa orang"
    imageCaption="Ruang latihan kekuatan — visual non-wajah"
    crumbs={crumbTrail}
    ctas={[
      { href: waAdmin, label: 'Tanya program', icon: 'whatsapp' },
      { href: '/harga', label: 'Lihat harga', variant: 'ghost' },
    ]}
    facts={facts}
  />

  <ProgramSessions
    heading="Sesi yang tersedia"
    lead="Dua sesi inti sudah terverifikasi dari kanal resmi gym; dua sesi pendukung masih estimasi dan menunggu konfirmasi admin."
    items={programs}
    ctaHref={waAdmin}
    ctaLabel="Tanya jadwal"
    note="Foto bersifat konteks visual (non-wajah), bukan dokumentasi sesi tertentu."
  />

  <EduList
    heading="Urutan latihan & persiapan"
    lead="Alur sederhana yang kami sarankan agar latihan aman dan kebiasaan terbentuk lebih cepat."
    groups={eduGroups}
  />

  <ScheduleTable
    heading="Kapan sesi berjalan?"
    lead="Jadwal mengikuti pemisahan sesi pria dan muslimah."
    rows={scheduleRows}
    note="Jam pasti belum dipublikasikan sebagai angka tetap — hubungi admin agar tidak salah datang."
  />

  <LocationSection
    heading="Lokasi latihan"
    lead="Kota Jambi. Admin mengarahkan rute paling akurat sebelum kamu datang."
  />

  <CtaBand
    heading="Belum yakin mulai dari mana?"
    body="Admin bisa membantu memilih sesi dan program yang paling sesuai dengan kondisimu saat ini."
    waHref={waAdmin}
    igUrl={business.instagram}
  />
</BaseLayout>
