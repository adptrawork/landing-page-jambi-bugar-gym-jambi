---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, ctaLink } from '../data/business';
---
<BaseLayout title={`Program ${business.name} — Sesi Pria/Wanita & Coaching`} description={`Program Jambi Bugar Gym: sesi latihan terpisah pria/wanita, pendampingan coach, asesmen awal. Jadwal via DM IG @jambibugar.gym.`} canonicalPath="/program">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="text-sm font-medium text-emerald-700">Program</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Program latihan terpisah pria & wanita</h1>
    <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Label <strong>Terverifikasi</strong> = sesuai bio IG resmi. Jam tiap sesi berubah — cek postingan atau DM IG.</p>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {programs.map((p, i) => (
        <article class={i % 2 === 1 ? 'md:mt-10' : ''}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
            <div class="p-7">
              <p class="text-xs font-medium text-emerald-700">{p.badge}</p>
              <h2 class="mt-1 font-semibold text-lg">{p.name}</h2>
              <p class="mt-1 text-base text-gray-600">{p.desc}</p>
              <a href={ctaLink(`Halo ${business.name}, saya mau tanya program ${p.name}.`)} class="mt-4 inline-block bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm">Tanya via DM IG</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 text-xs text-zinc-400">Sumber foto: Unsplash (foto konteks gym/kelas/coaching, bebas lisensi) — ganti foto asli gym.</p>
  </section>
</BaseLayout>
