---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, ctaLink } from '../data/business';
---
<BaseLayout title="Program Jambi Bugar Gym — Sesi Pria & Muslimah + Coaching" description="Program Jambi Bugar Gym: sesi latihan terpisah pria dan muslimah, pendampingan coach, asesmen awal. Jadwal tiap sesi via DM IG @jambibugar.gym." canonicalPath="/program">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">Program</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Program latihan terpisah pria &amp; muslimah</h1>
    <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Label <strong>Terverifikasi</strong> = sesuai bio IG resmi. Jam tiap sesi berubah — cek postingan atau DM IG.</p>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-6">
      {programs.map((p, i) => (
        <article class={i === 0 ? 'md:col-span-7' : i === 1 ? 'md:col-span-5' : i === 2 ? 'md:col-span-5' : 'md:col-span-7'}>
          <div class="lift bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] h-full">
            <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
            <div class="p-7">
              <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">{p.badge}</p>
              <h2 class="mt-1 font-semibold text-lg tracking-tight">{p.name}</h2>
              <p class="mt-1 text-base text-stone-600">{p.desc}</p>
              <a href={ctaLink(`Halo ${business.name}, saya mau tanya program ${p.name}.`)} class="mt-4 inline-block bg-stone-900 text-white px-5 py-2.5 rounded-full text-sm active:scale-[0.98]">Tanya via DM IG</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 text-xs text-stone-400">Sumber foto: Unsplash (foto konteks gym/kelas/coaching, bebas lisensi) — ganti foto asli gym.</p>
  </section>
</BaseLayout>
