---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, prices, ctaLink } from '../data/business';
const heroCta = ctaLink(`Halo ${business.name}, saya mau tanya jadwal sesi.`);
---
<!-- Ref: Unbounce fitness — head (hook) + content + CTA -->
<BaseLayout title="Harga transparan — Jambi Bugar Gym Jambi" description="Rumah Transformasi — Nyaman | Aman | Syari" canonicalPath="/Harga" image={business.ogImage}>
  <section class="bg-stone-900 text-white" aria-labelledby="subhead">
    <div class="max-w-7xl mx-auto px-4 pt-14 pb-12 md:pt-20 md:pb-16">
      <nav class="font-mono-num text-xs uppercase tracking-[0.18em] text-white/60" aria-label="Breadcrumb"><a href="/" class="hover:text-white">Beranda</a> / Harga paket</nav>
      <h1 id="subhead" class="mt-3 max-w-[20ch] text-3xl md:text-5xl font-black uppercase tracking-tighter">Harga transparan</h1>
      <p class="mt-3 max-w-[60ch] text-base text-white/75">Perbandingan paket — 1 paket Terpopuler, tanpa biaya tersembunyi.</p>
      <a href={heroCta} class="mt-6 inline-flex min-h-[48px] items-center rounded-full bg-emerald-800 px-7 text-sm font-black uppercase tracking-wide text-white transition hover:opacity-90">Tanya via DM IG</a>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20" aria-label="Daftar harga">
    <div class="grid grid-cols-1 gap-5 md:hidden">
      {prices.map((p, i) => (
        <article class:list={["relative rounded-3xl border p-6", i === 3 ? "border-emerald-800 bg-stone-900 text-white" : "border-stone-200 bg-white"]}>
          {i === 3 && <p class="absolute -top-3 left-6 rounded-full bg-emerald-800 px-3 py-1 text-[11px] font-black uppercase tracking-widest text-white">Terpopuler</p>}
          <p class="font-mono-num text-[11px] font-bold uppercase tracking-[0.18em]">{p.badge}</p>
          <h2 class="mt-1 font-extrabold">{p.name}</h2>
          <p class="mt-1 font-mono-num text-2xl font-bold">{p.price}</p>
          <p class="mt-1 text-sm opacity-80">{p.desc}</p>
          <a href={heroCta} class="mt-4 inline-flex min-h-[48px] items-center justify-center rounded-full bg-emerald-800 px-5 text-sm font-bold uppercase tracking-wide text-white">Pilih Paket</a>
        </article>
      ))}
    </div>
    <div class="hidden md:block">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {prices.map((p, i) => (
          <article class:list={["relative flex flex-col rounded-3xl border p-6", i === 3 ? "border-emerald-800 bg-stone-900 text-white md:-translate-y-2 shadow-xl" : "border-stone-200 bg-white"]}>
            {i === 3 && <p class="absolute -top-3 left-6 rounded-full bg-emerald-800 px-3 py-1 text-[11px] font-black uppercase tracking-widest text-white">Terpopuler</p>}
            <p class="font-mono-num text-[11px] font-bold uppercase tracking-[0.18em]">{p.badge}</p>
            <h2 class="mt-2 font-extrabold">{p.name}</h2>
            <p class="mt-1 font-mono-num text-2xl font-bold">{p.price}</p>
            <p class="mt-2 text-sm opacity-80">{p.desc}</p>
            <a href={heroCta} class="mt-4 inline-flex min-h-[48px] items-center justify-center rounded-full bg-emerald-800 px-5 text-sm font-bold uppercase tracking-wide text-white">Pilih Paket</a>
          </article>
        ))}
      </div>
    </div>
    <!-- Skeleton shimmer: placeholder saat harga dimuat -->
    <div class="skeleton mt-6 hidden h-24 rounded-3xl bg-stone-200" aria-hidden="true"></div>
    <p class="mt-4 text-xs text-stone-500">Harga estimasi — konfirmasi tarif via DM IG @jambibugar.gym.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 pb-12 md:pb-20" aria-label="Ajakan">
    <div class="rounded-3xl bg-stone-900 p-8 text-white md:p-10">
      <p class="text-2xl font-black uppercase tracking-tight">Kunci harga terbaik minggu ini</p>
      <p class="mt-2 text-sm text-white/70">Tanya slot & tarif akhir — gratis, tanpa komitmen.</p>
      <a href={heroCta} class="mt-5 inline-flex min-h-[48px] items-center rounded-full bg-white px-8 text-sm font-black uppercase tracking-wide text-stone-900">Tanya via DM IG</a>
    </div>
  </section>
</BaseLayout>
