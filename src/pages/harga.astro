---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, prices, ctaLink } from '../data/business';
---
<BaseLayout title={`Harga ${business.name} — Trial & Member`} description={`Harga Jambi Bugar Gym: angka estimasi, konfirmasi via DM IG @jambibugar.gym sebelum datang.`} canonicalPath="/harga">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="text-sm font-medium text-emerald-700">Harga</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Biaya latihan yang jujur</h1>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Semua angka <strong>Estimasi</strong> — price list resmi hanya via DM IG @jambibugar.gym. Jangan transfer sebelum konfirmasi.</p>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden">
          <img src="/images/jambi-bugar-4.jpg" alt="Asesmen kebugaran awal member Jambi Bugar Gym" width="800" height="600" loading="eager" class="w-full aspect-[4/3] object-cover" />
          <p class="p-5 text-sm text-gray-600">Mulai dari sesi coba — foto konteks, ganti foto asli. Sumber: Unsplash (bebas lisensi).</p>
        </div>
      </div>
    </div>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {prices.map((p, i) => (
        <article class={i % 2 === 1 ? 'md:mt-10' : ''}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <p class="text-xs font-medium text-emerald-700">{p.badge}</p>
            <h2 class="mt-1 font-semibold text-lg tracking-tight">{p.name}</h2>
            <p class="mt-1 text-sm text-gray-600">{p.desc}</p>
          </div>
          <div class="mt-3 flex items-center justify-between px-2">
            <p class="font-mono-num font-semibold">{p.price}</p>
            <a href={ctaLink(`Halo ${business.name}, saya mau tanya paket ${p.name} (${p.price}). Apakah masih berlaku?`)} class="bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm font-medium">Konfirmasi via DM IG</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
