---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, prices, ctaLink } from '../data/business';
---
<BaseLayout title="Harga Jambi Bugar Gym — Trial & Member Sesi Islami" description="Harga Jambi Bugar Gym: angka estimasi trial, harian, mingguan, bulanan. Price list resmi hanya via DM IG @jambibugar.gym." canonicalPath="/harga">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">Harga</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Biaya latihan yang jujur</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Semua angka <strong>Estimasi</strong> — price list resmi hanya via DM IG @jambibugar.gym. Jangan transfer sebelum konfirmasi.</p>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden">
          <img src="/images/jambi-bugar-4.jpg" alt="Asesmen kebugaran awal member Jambi Bugar Gym" width="800" height="600" loading="eager" class="w-full aspect-[4/3] object-cover" />
          <p class="p-5 text-sm text-stone-600">Mulai dari sesi coba — foto konteks, ganti foto asli. Sumber: Unsplash (bebas lisensi).</p>
        </div>
      </div>
    </div>
    <ol class="mt-10 bg-white border border-stone-200/70 rounded-[2.5rem] divide-y divide-stone-200/80 px-7 md:px-9 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
      {prices.map((p, i) => (
        <li class="flex flex-col md:flex-row md:items-center gap-3 md:gap-6 py-6">
          <span class="font-mono-num text-xs text-emerald-800 w-7 shrink-0">0{i + 1}</span>
          <div class="flex-1">
            <h2 class="font-semibold text-lg tracking-tight">{p.name}</h2>
            <p class="mt-0.5 text-sm text-stone-600">{p.desc} <span class="font-mono-num text-xs text-stone-400">[{p.badge}]</span></p>
          </div>
          <p class="font-mono-num font-semibold md:text-right whitespace-nowrap">{p.price}</p>
          <a href={ctaLink(`Halo ${business.name}, saya mau tanya paket ${p.name} (${p.price}). Apakah masih berlaku?`)} class="shrink-0 bg-stone-900 text-white px-5 py-2.5 rounded-full text-sm font-medium text-center active:scale-[0.98]">Konfirmasi via DM IG</a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
