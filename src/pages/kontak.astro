---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapFacade from '../components/MapFacade.astro';
import { business, ctaLink } from '../data/business';
const heroCta = ctaLink(`Halo ${business.name}, saya mau tanya jadwal sesi.`);
---
<!-- Ref: Unbounce fitness — head (hook) + content + CTA -->
<BaseLayout title="Hubungi & kunjungi — Jambi Bugar Gym Jambi" description="Rumah Transformasi — Nyaman | Aman | Syari" canonicalPath="/Kontak" image={business.ogImage}>
  <section class="bg-stone-900 text-white" aria-labelledby="subhead">
    <div class="max-w-7xl mx-auto px-4 pt-14 pb-12 md:pt-20 md:pb-16">
      <nav class="font-mono-num text-xs uppercase tracking-[0.18em] text-white/60" aria-label="Breadcrumb"><a href="/" class="hover:text-white">Beranda</a> / Kontak & lokasi</nav>
      <h1 id="subhead" class="mt-3 max-w-[20ch] text-3xl md:text-5xl font-black uppercase tracking-tighter">Hubungi & kunjungi</h1>
      <p class="mt-3 max-w-[60ch] text-base text-white/75">Kontak resmi, jam operasional, dan rute ke lokasi.</p>
      <a href={heroCta} class="mt-6 inline-flex min-h-[48px] items-center rounded-full bg-emerald-800 px-7 text-sm font-black uppercase tracking-wide text-white transition hover:opacity-90">Tanya via DM IG</a>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20" aria-label="Info kontak">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-5 rounded-3xl border border-stone-200 bg-white p-6 md:p-8">
        <h2 class="text-xl font-extrabold tracking-tight">Kontak resmi</h2>
        <p class="mt-2 text-sm text-stone-600">{business.address}<br />{business.hours}</p>
        <div class="mt-5 flex flex-col gap-3">
          <a href={heroCta} class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-emerald-800 px-6 text-sm font-bold uppercase tracking-wide text-white">Tanya via DM IG</a>
          <a href={business.instagram} class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-stone-300 px-6 text-sm font-bold uppercase tracking-wide">Instagram @jambibugar.gym</a>
        </div>
      </div>
      <div class="md:col-span-7">
        <MapFacade src={business.mapsEmbed} title="Peta lokasi" mapsUrl={business.mapsUrl} />
        <p class="mt-3 text-sm text-stone-600">Buka rute via <a class="underline underline-offset-4 font-semibold" href={business.mapsUrl}>Google Maps</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
