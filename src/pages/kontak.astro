---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
---
<BaseLayout title="Kontak Jambi Bugar Gym — Daftar via DM IG" description="Hubungi Jambi Bugar Gym via DM IG @jambibugar.gym untuk jadwal sesi pria dan muslimah. Nomor WA resmi belum terverifikasi." canonicalPath="/kontak">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7">
        <p class="text-xs font-semibold tracking-widest uppercase text-emerald-800">Kontak</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Daftar via DM Instagram</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Nomor WA resmi <strong>belum terverifikasi</strong> — jangan percaya nomor dari sumber lain. Isi format chat, salin, lalu tempel di DM @jambibugar.gym.</p>
        <div class="mt-8 bg-white border border-stone-200/70 rounded-[2.5rem] p-8 space-y-4">
          <div><label for="nama" class="text-sm font-medium">Nama</label><input id="nama" placeholder="Nama kamu" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-stone-50" /></div>
          <div><label for="sesi" class="text-sm font-medium">Sesi</label><select id="sesi" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-stone-50"><option>Sesi Pria</option><option>Sesi Muslimah</option></select></div>
          <div class="flex flex-wrap gap-3">
            <button id="copy" class="bg-emerald-800 text-white px-7 py-3.5 rounded-full font-medium active:scale-[0.98]">Salin Format Chat</button>
            <a href={business.instagram} class="border border-stone-300 px-7 py-3.5 rounded-full font-medium hover:border-emerald-800 hover:text-emerald-800">Buka IG @jambibugar.gym</a>
          </div>
          <p id="ok" class="hidden text-sm text-emerald-800">Tersalin — tempel di DM Instagram @jambibugar.gym.</p>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden">
          <img src="/images/jambi-bugar-5.jpg" alt="Kelas kebugaran sesi muslimah di Jambi Bugar Gym" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
          <div class="p-8">
            <p class="font-semibold">Info kunjungan</p>
            <p class="mt-2 text-sm text-stone-600">{business.address}</p>
            <p class="mt-1 text-sm text-stone-600">{business.hours}</p>
            <p class="mt-1 text-sm text-stone-600">IG: @jambibugar.gym (848 pengikut)</p>
            <a class="mt-4 inline-block underline underline-offset-4" href={business.mapsUrl}>Rute ke lokasi</a>
          </div>
        </div>
        <p class="mt-3 text-xs text-stone-400">Sumber foto: Unsplash (bebas lisensi) — ganti foto asli gym.</p>
      </div>
    </div>
    <div class="mt-8 rounded-[2.5rem] overflow-hidden border border-stone-200/70 aspect-video bg-stone-100">
      <iframe title="Peta Jambi Bugar Gym" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
    </div>
  </section>
<script is:inline>
document.getElementById('copy').addEventListener('click', function() {
  var nama = (document.getElementById('nama').value || '').trim() || '[nama]';
  var sesi = document.getElementById('sesi').value;
  var msg = 'Halo Jambi Bugar Gym, saya ' + nama + '. Mau tanya jadwal ' + sesi + '. Apakah ada slot?';
  navigator.clipboard.writeText(msg).then(function() {
    document.getElementById('ok').classList.remove('hidden');
  });
});
</script>
</BaseLayout>
