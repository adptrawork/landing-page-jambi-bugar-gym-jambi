---
import Icon from './Icon.astro';
interface Item { name: string; price: string; badge: string; desc: string; }
interface Props { eyebrow?: string; heading: string; lead?: string; items: Item[]; ctaHref: string; note?: string; headingId?: string; }
const { eyebrow = 'Harga & paket', heading, lead, items, ctaHref, note, headingId = 'harga' } = Astro.props;
const verified = (badge: string) => badge.toLowerCase().includes('verifikasi');
---

<section class="border-b border-ink/15" aria-labelledby={headingId}>
  <div class="shell py-14 md:py-20">
    <div class="grid gap-4 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow reveal text-accent" style="--i:0">{eyebrow}</p>
        <h2 id={headingId} class="reveal mt-3 max-w-[24ch] font-display text-3xl md:text-4xl" style="--i:0">{heading}</h2>
      </div>
      {lead && <p class="reveal max-w-prose text-sm leading-relaxed text-ink/70 md:col-span-5" style="--i:1">{lead}</p>}
    </div>

    <ul class="ruled mt-10">
      {items.map((p, i) => (
        <li class="ruled-item reveal" style={`--i:${Math.min(i + 1, 5)}`}>
          <div class="grid items-baseline gap-x-6 gap-y-2 py-5 md:grid-cols-12">
            <div class="md:col-span-5">
              <h3 class="font-display text-lg">{p.name}</h3>
              <p class:list={['eyebrow mt-1', verified(p.badge) ? 'text-accent' : 'text-ink/75']}>{p.badge}</p>
            </div>
            <p class="text-sm leading-relaxed text-ink/70 md:col-span-4">{p.desc}</p>
            <div class="flex items-baseline gap-4 md:col-span-3 md:justify-end">
              <p class="font-display text-xl tabular-nums">{p.price}</p>
              <a href={ctaHref} class="inline-flex min-h-[40px] items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">
                <Icon name="whatsapp" size={15} />Tanya
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>

    {note && (
      <p class="mt-6 flex max-w-prose items-start gap-3 text-sm leading-relaxed text-ink/70">
        <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true"><Icon name="info" size={18} /></span>{note}
      </p>
    )}
  </div>
</section>
