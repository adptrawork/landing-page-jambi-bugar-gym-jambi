---
import Icon from './Icon.astro';
interface Props { heading: string; body: string; waHref: string; waLabel?: string; igUrl: string; }
const { heading, body, waHref, waLabel = 'Tanya via WhatsApp', igUrl } = Astro.props;
---
<!-- Ref: calm editorial coach directory — penutup kontak ringkas, satu CTA utama -->
<section class="on-dark bg-forest text-paper" aria-labelledby="cta-penutup">
  <div class="shell grid gap-8 py-14 md:grid-cols-12 md:items-end md:py-16">
    <div class="md:col-span-7">
      <p class="eyebrow text-paper/70">Langkah berikutnya</p>
      <h2 id="cta-penutup" class="mt-3 max-w-[22ch] font-display text-3xl md:text-4xl">{heading}</h2>
      <p class="mt-4 max-w-prose text-sm leading-relaxed text-paper/80">{body}</p>
    </div>
    <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
      <a href={waHref} class="btn btn-accent">
        <Icon name="whatsapp" size={18} />{waLabel}
      </a>
      <a href={igUrl} class="btn btn-ghost">
        <Icon name="instagram" size={18} />Instagram
      </a>
    </div>
  </div>
</section>
