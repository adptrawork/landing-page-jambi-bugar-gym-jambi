---
// @ts-nocheck
/**
 * Ikon SVG inline — stroke 1.5/2, currentColor, tanpa emoji.
 * WhatsApp digambar sebagai gelembung obrolan + gagang telepon (monokrom, stroke)
 * agar tetap sesuai aturan "ikon = SVG inline".
 */
interface Props { name: string; size?: number; class?: string; }
const { name, size = 20, class: cls = '' } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.6,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
  focusable: 'false',
  class: cls,
};
---
{name === 'whatsapp' && (
  <svg {...common}>
    <path d="M20 12.4a7.7 7.7 0 0 1-8.1 7.2 8.4 8.4 0 0 1-3.2-.6L4 21l1.7-4.1A7.4 7.4 0 0 1 4 12.4 7.9 7.9 0 0 1 12 5a7.9 7.9 0 0 1 8 7.4Z" />
    <path d="M9.6 9.4c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.8.4-.3.3-.9 1-.9 2.2s.9 2.5 1 2.7c.2.2 1.7 2.8 4.2 3.7 2 .8 2.5.7 3 .6.5-.1 1.3-.6 1.5-1.2.2-.6.2-1 .1-1.1-.1-.1-.2-.2-.5-.3l-1.5-.8c-.2-.1-.4-.1-.5.1l-.7.9c-.1.1-.3.2-.5.1a5.9 5.9 0 0 1-1.7-1.1 6.3 6.3 0 0 1-1.2-1.5c-.1-.2 0-.3.1-.4l.5-.5c.1-.2.1-.3.2-.5v-.4l-.5-1.4Z" />
  </svg>
)}
{name === 'instagram' && (
  <svg {...common}>
    <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <path d="M17.1 7.1h.01" />
  </svg>
)}
{name === 'pin' && (
  <svg {...common}>
    <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" />
    <circle cx="12" cy="10" r="2.6" />
  </svg>
)}
{name === 'whatsapp-phone' && (
  <svg {...common}>
    <path d="M6.5 4h3l1.4 3.5-2 1.4a11 11 0 0 0 6.2 6.2l1.4-2L20 14.5v3a1.5 1.5 0 0 1-1.6 1.5A15.5 15.5 0 0 1 5 5.6 1.5 1.5 0 0 1 6.5 4Z" />
  </svg>
)}
{name === 'clock' && (
  <svg {...common}>
    <circle cx="12" cy="12" r="8.5" />
    <path d="M12 7.5V12l3 2" />
  </svg>
)}
{name === 'arrow-right' && (
  <svg {...common}>
    <path d="M4 12h15" />
    <path d="m13 6 6 6-6 6" />
  </svg>
)}
{name === 'arrow-up-right' && (
  <svg {...common}>
    <path d="M7 17 17 7" />
    <path d="M8 7h9v9" />
  </svg>
)}
{name === 'check' && (
  <svg {...common}>
    <path d="m5 12.5 4.5 4.5L19 7.5" />
  </svg>
)}
{name === 'info' && (
  <svg {...common}>
    <circle cx="12" cy="12" r="8.5" />
    <path d="M12 11v5" />
    <path d="M12 7.8h.01" />
  </svg>
)}
{name === 'calendar' && (
  <svg {...common}>
    <rect x="3.5" y="4.5" width="17" height="16" rx="2.5" />
    <path d="M3.5 9.5h17" />
    <path d="M8 3.5v3M16 3.5v3" />
  </svg>
)}
{name === 'users' && (
  <svg {...common}>
    <circle cx="9" cy="8" r="3.2" />
    <path d="M3.5 19.5a5.5 5.5 0 0 1 11 0" />
    <path d="M16.2 5.6a3.2 3.2 0 0 1 0 6.3" />
    <path d="M17.6 14.5a5.5 5.5 0 0 1 3 5" />
  </svg>
)}
{name === 'dumbbell' && (
  <svg {...common}>
    <path d="M6.5 8.5v7M3.8 10v4M17.5 8.5v7M20.2 10v4M6.5 12h11" />
  </svg>
)}
{name === 'route' && (
  <svg {...common}>
    <circle cx="6" cy="18" r="2.5" />
    <circle cx="18" cy="6" r="2.5" />
    <path d="M15.5 6H10a4 4 0 0 0 0 8h4a4 4 0 0 1 0 8h-5.5" />
  </svg>
)}
