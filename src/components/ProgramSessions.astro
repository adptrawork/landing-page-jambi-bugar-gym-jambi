---
import Icon from './Icon.astro';
interface Item { name: string; badge: string; desc: string; img: string; alt: string; }
interface Props { eyebrow?: string; heading: string; lead?: string; items: Item[]; ctaHref?: string; ctaLabel?: string; note?: string; headingId?: string; }
const { eyebrow = 'Program & sesi', heading, lead, items, ctaHref = '#', ctaLabel = 'Tanya jadwal', note, headingId = 'program-sesi' } = Astro.props;
const verified = (badge: string) => badge.toLowerCase().includes('verifikasi');
---
<!-- Ref: calm editorial coach directory — program sebagai zig-zag 2 kolom ber-rule -->
<section class="border-b border-ink/15" aria-labelledby={headingId}>
  <div class="shell py-14 md:py-20">
    <div class="grid gap-4 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow reveal text-accent" style="--i:0">{eyebrow}</p>
        <h2 id={headingId} class="reveal mt-3 max-w-[24ch] font-display text-3xl md:text-4xl" style="--i:0">{heading}</h2>
      </div>
      {lead && <p class="reveal max-w-prose text-sm leading-relaxed text-ink/70 md:col-span-5" style="--i:1">{lead}</p>}
    </div>

    <ul class="mt-12">
      {items.map((p, i) => (
        <li class:list={['ruled-item grid items-center gap-6 py-8 md:grid-cols-12 md:gap-12 md:py-10']}>
          <div class:list={['overflow-hidden rounded-[2px] border border-ink/15 bg-paper-2 md:col-span-6', i % 2 === 1 ? 'md:order-2' : '']}>
            <img src={p.img} alt={p.alt} width="800" height="533" loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover" />
          </div>
          <div class:list={['md:col-span-6', i % 2 === 1 ? 'md:order-1' : '']}>
            <p class="flex items-center gap-2">
              <span class:list={['h-px w-8', verified(p.badge) ? 'bg-accent' : 'bg-ink/25']} aria-hidden="true"></span>
              <span class:list={['eyebrow', verified(p.badge) ? 'text-accent' : 'text-ink/55']}>{p.badge}</span>
            </p>
            <h3 class="mt-3 font-display text-2xl">{p.name}</h3>
            <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink/75">{p.desc}</p>
            <a href={ctaHref} class="btn btn-ghost mt-6">
              <Icon name="whatsapp" size={16} />{ctaLabel}
            </a>
          </div>
        </li>
      ))}
    </ul>

    {note && <p class="mt-6 max-w-prose text-xs leading-relaxed text-ink/55">{note}</p>}
  </div>
</section>
