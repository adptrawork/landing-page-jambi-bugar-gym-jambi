---
interface Group { title: string; items: string[]; }
interface Props { eyebrow?: string; heading: string; lead?: string; groups: Group[]; headingId?: string; }
const { eyebrow = 'Edukasi', heading, lead, groups, headingId = 'edukasi' } = Astro.props;
---
<!-- Ref: calm editorial coach directory — blok edukasi sebagai list bernomor ber-rule -->
<section class="border-b border-ink/15 bg-paper-2/40" aria-labelledby={headingId}>
  <div class="shell grid gap-10 py-14 md:grid-cols-12 md:gap-14 md:py-20">
    <div class="md:col-span-4">
      <p class="eyebrow reveal text-accent" style="--i:0">{eyebrow}</p>
      <h2 id={headingId} class="reveal mt-3 font-display text-3xl md:text-4xl" style="--i:0">{heading}</h2>
      {lead && <p class="reveal mt-5 max-w-prose text-sm leading-relaxed text-ink/75" style="--i:1">{lead}</p>}
    </div>

    <div class="md:col-span-8">
      {groups.map((g, gi) => (
        <div class:list={['reveal', gi > 0 ? 'mt-10' : '']} style={`--i:${gi + 1}`}>
          <h3 class="eyebrow border-b border-ink/20 pb-3 text-ink/70">{g.title}</h3>
          <ol class="mt-1">
            {g.items.map((it, i) => (
              <li class="ruled-item flex items-baseline gap-5 py-4">
                <span class="font-display text-sm font-bold tabular-nums text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-sm leading-relaxed text-ink/85">{it}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
