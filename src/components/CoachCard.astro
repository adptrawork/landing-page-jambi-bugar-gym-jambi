---
const { role, spec, credential, desc, badge, accent = 'emerald-800' } = Astro.props;
---

<article class="rounded-3xl border border-stone-200 bg-white p-6">
  <div class={`grid h-14 w-14 place-items-center rounded-2xl bg-${accent} font-mono-num text-lg font-bold text-white`} aria-hidden="true">{(role ?? 'C').slice(0, 1)}</div>
  <p class={`mt-4 font-mono-num text-[11px] font-bold uppercase tracking-[0.18em] text-${accent}`}>{badge ?? 'Coach'}</p>
  <h3 class="mt-1 text-lg font-extrabold tracking-tight">{role}</h3>
  {spec && <p class="mt-1 text-sm font-semibold text-stone-700">{spec}</p>}
  {credential && <p class="mt-1 font-mono-num text-xs text-stone-500">{credential}</p>}
  {desc && <p class="mt-2 text-sm leading-relaxed text-stone-600">{desc}</p>}
</article>
