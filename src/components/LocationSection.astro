---
import Icon from './Icon.astro';
import MapFacade from './MapFacade.astro';
import { business, coachNoe, adminContact, waLink } from '../data/business';
interface Props { eyebrow?: string; heading: string; lead?: string; headingId?: string; }
const { eyebrow = 'Lokasi', heading, lead, headingId = 'lokasi' } = Astro.props;
const waAdmin = waLink(adminContact.phone, `Halo admin ${business.name}, saya mau tanya alamat & rute lokasi.`);
const waCoach = waLink(coachNoe.phone, `Halo ${coachNoe.name}, saya mau tanya rute ke ${business.name}.`);
---
<!-- Ref: calm editorial coach directory — lokasi + MapFacade klik-untuk-muat + CTA WhatsApp/Instagram -->
<section class="border-b border-ink/15" aria-labelledby={headingId}>
  <div class="shell grid gap-10 py-14 md:grid-cols-12 md:gap-12 md:py-20">
    <div class="md:col-span-5">
      <p class="eyebrow reveal text-accent" style="--i:0">{eyebrow}</p>
      <h2 id={headingId} class="reveal mt-3 max-w-[20ch] font-display text-3xl md:text-4xl" style="--i:0">{heading}</h2>
      {lead && <p class="reveal mt-5 max-w-prose text-sm leading-relaxed text-ink/75" style="--i:1">{lead}</p>}

      <dl class="reveal ruled mt-8" style="--i:2">
        <div class="ruled-item flex items-start gap-4 py-4">
          <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true"><Icon name="pin" size={18} /></span>
          <div>
            <dt class="eyebrow text-ink/55">Lokasi</dt>
            <dd class="mt-1 text-sm leading-relaxed text-ink/85">{business.address}</dd>
          </div>
        </div>
        <div class="ruled-item flex items-start gap-4 py-4">
          <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true"><Icon name="clock" size={18} /></span>
          <div>
            <dt class="eyebrow text-ink/55">Jam & sesi</dt>
            <dd class="mt-1 text-sm leading-relaxed text-ink/85">{business.hours}</dd>
          </div>
        </div>
      </dl>

      <div class="reveal mt-8 flex flex-wrap gap-3" style="--i:3">
        <a href={waAdmin} class="btn btn-primary">
          <Icon name="whatsapp" size={18} />WhatsApp admin
        </a>
        <a href={business.instagram} class="btn btn-ghost">
          <Icon name="instagram" size={18} />@JambiBugar.Gym
        </a>
      </div>
      <p class="reveal mt-4 text-xs text-ink/55" style="--i:3">Nomor pelatih: <a href={waCoach} class="tlink">{coachNoe.phone}</a> &middot; admin: <a href={waAdmin} class="tlink">{adminContact.phone}</a></p>
    </div>

    <div class="reveal md:col-span-7" style="--i:2">
      <MapFacade src={business.mapsEmbed} title={`Peta lokasi ${business.name}`} mapsUrl={business.mapsUrl} />
      <p class="mt-3 flex items-center gap-2 text-xs text-ink/60">
        <Icon name="route" size={16} />Peta dimuat saat diklik. Buka rute via <a href={business.mapsUrl} class="tlink">Google Maps</a>.
      </p>
    </div>
  </div>
</section>
