---
import Icon from './Icon.astro';
import { business } from '../data/business';

interface Cta { href: string; label: string; icon?: string; variant?: 'primary' | 'ghost' | 'accent'; }
interface Fact { k: string; v: string; }
interface Props {
  eyebrow: string;
  /** Baris-baris headline; tiap item jadi satu baris poster. Tetap satu heading utuh. */
  lines: string[];
  lead: string;
  image: string;
  imageAlt: string;
  imageCaption?: string;
  ctas?: Cta[];
  facts?: Fact[];
  headingId?: string;
}

const {
  eyebrow,
  lines,
  lead,
  image,
  imageAlt,
  imageCaption = 'Visual non-wajah',
  ctas = [],
  facts = [],
  headingId = 'judul-halaman',
} = Astro.props;

// Sudut rotasi per baris headline — kesan poster cetak yang ditulis tangan.
const angles = ['-2.2deg', '1.6deg', '-1deg', '2.4deg'];
const lineAngle = (i: number) => angles[i % angles.length];
// Baris terakhir dibalik warna accent (reversed out), seperti judul utama pada flyer cetak.
const reversedIndex = lines.length - 1;
// Meterai: angka & label diambil dari business.followers ("848 pengikut IG"), tanpa hardcode.
const followersNum = business.followers.match(/[\d.,]+/)?.[0] ?? '';
const followersLabel = business.followers.replace(/^[\d.,\s]+/, '');
---


<section class="poster border-b border-ink/15" aria-labelledby={headingId}>
  <div class="shell relative py-12 md:py-20">
    <div class="grid items-start gap-10 md:grid-cols-12 md:gap-8">
      <div class="relative md:col-span-7 md:col-start-1">
        
        <span
          class="poster-outline pointer-events-none absolute -top-3 hidden h-[62%] w-[76%] border-2 border-accent/45 md:block"
          style="--r: -2.4deg"
          aria-hidden="true"
        ></span>

        <p class="poster-in eyebrow text-accent" style="--i:0">{eyebrow}</p>

        
        <h1
          id={headingId}
          class="relative mt-5 font-display text-[clamp(2.5rem,6.2vw,4.6rem)] font-bold leading-[0.98] tracking-[-0.02em]"
        >
          {lines.map((line, i) => (
            <span
              class:list={[
                'poster-line poster-in block w-fit max-w-full',
                i === reversedIndex &&
                  'poster-line--reverse halftone mt-2 inline-block bg-accent px-3 py-1 text-paper',
              ]}
              style={`--r:${lineAngle(i)}; --i:${i + 1}`}
            >{line}</span>
          ))}
        </h1>

        <p class="poster-in mt-7 max-w-[46ch] text-base leading-relaxed text-ink/80 md:text-lg" style="--i:5">
          {lead}
        </p>

        {ctas.length > 0 && (
          <div class="poster-in mt-8 flex flex-wrap gap-3" style="--i:6">
            {ctas.map((c) => (
              <a
                href={c.href}
                class:list={[
                  'btn',
                  c.variant === 'ghost' ? 'btn-ghost' : c.variant === 'accent' ? 'btn-accent' : 'btn-primary',
                ]}
              >
                {c.icon && <Icon name={c.icon} size={18} />}{c.label}
              </a>
            ))}
          </div>
        )}
      </div>

      
      <div class="poster-in relative md:col-span-5 md:col-start-8" style="--i:3">
        <span
          class="poster-outline pointer-events-none absolute -bottom-5 -left-5 hidden h-full w-full border-2 border-ink/35 md:block"
          style="--r: 2.6deg"
          aria-hidden="true"
        ></span>

        <figure class="poster-rot border border-ink/25 bg-accent" style="--r: -1.8deg">
          <div class="flyer-photo">
            <img
              src={image}
              alt={imageAlt}
              width="800"
              height="533"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-[4/5] w-full object-cover"
            />
          </div>
          <figcaption class="flex items-center gap-2 border-t border-ink/25 bg-paper px-4 py-3 text-xs text-ink/70">
            <Icon name="dumbbell" size={16} />{imageCaption}
          </figcaption>
        </figure>

        
        <p class="poster-rot poster-stamp pointer-events-none absolute z-10 hidden select-none lg:block" style="--r: -9deg">
          <span class="sr-only">{business.followers}</span>
          <span aria-hidden="true" class="block px-2 text-center">
            <span class="block text-[1.6rem] font-bold leading-none text-forest">{followersNum}</span>
            <span class="mt-1 block text-[0.5625rem] font-semibold uppercase leading-tight tracking-[0.12em] text-forest">
              {followersLabel}
            </span>
          </span>
        </p>

        
        <p
          class="poster-rot absolute -left-3 top-8 z-10 border border-ink/25 bg-paper px-3 py-2 text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-ink shadow-[3px_3px_0_0_var(--accent)]"
          style="--r: -4.5deg"
        >
          {business.category}
        </p>
        <p
          class="poster-rot absolute -right-1 -top-5 z-10 border border-ink/25 bg-paper px-3 py-2 text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-ink shadow-[3px_3px_0_0_var(--accent)] md:-right-5"
          style="--r: 5deg"
        >
          {business.city}
        </p>
      </div>
    </div>

    
    {facts.length > 0 && (
      <dl class="poster-in mt-12 flex flex-wrap gap-3 md:mt-14" style="--i:7">
        {facts.map((f, i) => (
          <>
            <dt
              class="poster-rot min-w-[9.5rem] max-w-full border border-ink/30 bg-paper px-3.5 py-2.5 flex flex-col gap-1"
              style={`--r:${i % 2 === 0 ? '-1.2deg' : '1.4deg'}`}
            >
              <span class="eyebrow text-accent">{f.k}</span>
            </dt>
            <dd class="mt-1 text-[0.8125rem] leading-snug text-ink/85">{f.v}</dd>
          </>
        ))}
      </dl>
    )}
  </div>
</section>