---
import Icon from './Icon.astro';
import { business, waLink } from '../data/business';
interface Coach {
  name: string; fullName: string; monogram: string; role: string; focus: string; note: string; phone: string; img: string; alt: string;
}
interface Props { coach: Coach; headingId?: string; }
const { coach, headingId = 'pelatih-utama' } = Astro.props;
const wa = waLink(coach.phone, `Assalamualaikum ${coach.name}, saya mau tanya pendekatan latihan di ${business.name}.`);
---

<section class="border-b border-ink/15" aria-labelledby={headingId}>
  <div class="shell py-14 md:py-20">
    <p class="eyebrow reveal text-accent" style="--i:0">Pelatih utama</p>
    <h2 id={headingId} class="reveal mt-3 max-w-[24ch] font-display text-3xl md:text-4xl" style="--i:0">Dipandu orang yang menjelaskan, bukan sekadar menyuruh</h2>

    <div class="reveal mt-10 grid gap-8 md:grid-cols-12 md:gap-12" style="--i:1">
      <div class="md:col-span-5">
        <figure class="relative overflow-hidden rounded-[2px] border border-ink/15 bg-paper-2">
          <img src={coach.img} alt={coach.alt} width="640" height="800" loading="lazy" decoding="async" class="aspect-[4/5] w-full object-cover" />
          <figcaption class="absolute bottom-4 left-4 grid h-20 w-20 place-items-center rounded-[2px] bg-forest font-display text-2xl font-bold text-paper" aria-hidden="true">{coach.monogram}</figcaption>
        </figure>
        <p class="mt-3 text-xs text-ink/75">Visual non-wajah &mdash; kami tidak memasang foto wajah orang lain sebagai pelatih.</p>
      </div>

      <div class="md:col-span-7">
        <h3 class="font-display text-2xl md:text-3xl">{coach.name}</h3>
        <p class="mt-2 text-sm text-ink/70">{coach.fullName} &mdash; {coach.role}</p>
        <span class="mt-4 inline-flex items-center gap-2 rounded-[2px] border border-accent/40 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-accent">
          <Icon name="info" size={14} />Peran terverifikasi sumber publik
        </span>
        <p class="mt-6 max-w-prose leading-relaxed text-ink/80">{coach.note}</p>

        <dl class="ruled mt-8 max-w-prose flex flex-col gap-0 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-6">
          <dt class="eyebrow w-32 shrink-0 text-ink/75 py-4 border-b border-ink/15">Fokus</dt>
          <dd class="text-sm text-ink/85 py-4 border-b border-ink/15">{coach.focus}</dd>
          <dt class="eyebrow w-32 shrink-0 text-ink/75 py-4 border-b border-ink/15">Kontak pelatih</dt>
          <dd class="text-sm text-ink/85 py-4 border-b border-ink/15">
            <a href={wa} class="inline-flex min-h-[32px] items-center gap-2 font-medium text-ink underline decoration-accent/50 underline-offset-4 hover:decoration-accent">
              <Icon name="whatsapp" size={16} />{coach.phone}
            </a>
          </dd>
        </dl>

        <a href={wa} class="btn btn-primary mt-8">
          <Icon name="whatsapp" size={18} />Tanya Coach Noe
        </a>
      </div>
    </div>
  </div>
</section>
