---
import Icon from './Icon.astro';
interface Cta { href: string; label: string; icon?: string; variant?: 'primary' | 'ghost'; }
interface Fact { k: string; v: string; }
interface Crumb { name: string; url: string; }
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image: string;
  imageAlt: string;
  imageCaption?: string;
  crumbs?: Crumb[];
  ctas?: Cta[];
  facts?: Fact[];
  headingId?: string;
}
const { eyebrow, title, lead, image, imageAlt, imageCaption = 'Visual non-wajah', crumbs = [], ctas = [], facts = [], headingId = 'judul-halaman' } = Astro.props;
---
<!-- Ref: calm editorial coach directory, serif tenang + list ber-rule (hero asimetris) -->
<section class="border-b border-ink/15" aria-labelledby={headingId}>
  <div class="shell grid items-center gap-10 py-12 md:grid-cols-12 md:gap-12 md:py-20">
    <div class="md:col-span-7">
      {crumbs.length > 0 && (
        <nav class="mb-6" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2 text-xs text-ink/60">
            {crumbs.map((c, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span aria-hidden="true" class="text-ink/35">/</span>}
                {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.url} class="hover:text-ink">{c.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )}

      <p class="eyebrow reveal text-accent" style="--i:0">{eyebrow}</p>
      <h1 id={headingId} class="reveal mt-4 max-w-[18ch] font-display text-[2rem] leading-[1.15] sm:text-4xl md:text-5xl" style="--i:1">{title}</h1>
      <p class="reveal mt-5 max-w-prose text-base leading-relaxed text-ink/75 md:text-lg" style="--i:2">{lead}</p>

      {ctas.length > 0 && (
        <div class="reveal mt-8 flex flex-wrap gap-3" style="--i:3">
          {ctas.map((c) => (
            <a href={c.href} class:list={['btn', c.variant === 'ghost' ? 'btn-ghost' : 'btn-primary']}>
              {c.icon && <Icon name={c.icon} size={18} />}{c.label}
            </a>
          ))}
        </div>
      )}

      {facts.length > 0 && (
        <dl class="reveal ruled mt-10 grid gap-x-8 sm:grid-cols-2" style="--i:4">
          {facts.map((f) => (
            <div class="ruled-item py-3.5">
              <dt class="eyebrow text-ink/55">{f.k}</dt>
              <dd class="mt-1 text-sm text-ink/85">{f.v}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <div class="reveal relative md:col-span-5" style="--i:2">
      <div class="absolute -right-3 -top-3 hidden h-full w-full rounded-[2px] bg-paper-2/60 md:block" aria-hidden="true"></div>
      <figure class="relative overflow-hidden rounded-[2px] border border-ink/15 bg-paper-2">
        <img src={image} alt={imageAlt} width="800" height="960" loading="eager" decoding="async" class="aspect-[4/5] w-full object-cover" />
        <figcaption class="flex items-center gap-2 border-t border-ink/15 bg-paper px-4 py-3 text-xs text-ink/60">
          <Icon name="dumbbell" size={16} />{imageCaption}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
