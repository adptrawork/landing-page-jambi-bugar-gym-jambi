---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; }
const { title, description, canonicalPath = '/', image } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://jambibugar-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
import { business, ctaLink } from '../data/business';
const cta = ctaLink(`Halo Jambi Bugar Gym, saya mau tanya jadwal sesi pria/wanita.`);
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} />
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <div class="border-b border-emerald-800/15 bg-emerald-800/[0.05]">
    <p class="max-w-7xl mx-auto px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-emerald-800">Rumah Transformasi &mdash; Nyaman, Aman, Syari &bull; Sesi Pria &amp; Muslimah terpisah</p>
  </div>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Buka tutup menu navigasi" />
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-xl border-b border-stone-200/70">
    <nav class="max-w-7xl mx-auto flex items-center justify-between gap-3 px-4 py-3" aria-label="Navigasi utama">
      <a href="/" class="flex items-center gap-2.5 min-h-[48px]">
        <span class="grid place-items-center w-9 h-9 rounded-xl bg-emerald-800 text-white font-black" aria-hidden="true">B</span>
        <span class="font-black tracking-tight uppercase leading-none">Jambi Bugar<small class="block text-[10px] font-bold tracking-[0.2em] text-emerald-800">HOME GYM ISLAMI</small></span>
      </a>
      <div class="hidden md:flex items-center gap-6 text-sm font-bold uppercase tracking-wide text-stone-600">
        <a href="/" class="min-h-[48px] inline-flex items-center hover:text-emerald-800 transition">Beranda</a>
        <a href="/program" class="min-h-[48px] inline-flex items-center hover:text-emerald-800 transition">Program</a>
        <a href="/pelatih" class="min-h-[48px] inline-flex items-center hover:text-emerald-800 transition">Pelatih</a>
        <a href="/harga" class="min-h-[48px] inline-flex items-center hover:text-emerald-800 transition">Harga</a>
        <a href="/kontak" class="min-h-[48px] inline-flex items-center hover:text-emerald-800 transition">Kontak</a>
      </div>
      <div class="flex items-center gap-2">
        <a href={cta} class="hidden sm:inline-flex items-center min-h-[48px] px-5 rounded-full text-sm font-bold uppercase tracking-wide bg-emerald-800 text-white transition hover:bg-emerald-900 active:scale-[0.98]">Tanya via DM IG</a>
        <label for="nav-toggle" class="burger md:hidden grid place-items-center min-w-[48px] min-h-[48px] rounded-xl border border-stone-300 cursor-pointer" aria-hidden="true"><span></span><span></span><span></span></label>
      </div>
      <div class="mobile-menu absolute inset-x-0 top-full bg-white border-b border-stone-200 shadow-lg md:hidden">
        <div class="px-4 py-3 flex flex-col text-sm font-bold uppercase tracking-wide">
          <a href="/" class="min-h-[48px] inline-flex items-center border-b border-stone-100">Beranda</a>
          <a href="/program" class="min-h-[48px] inline-flex items-center border-b border-stone-100">Program</a>
          <a href="/pelatih" class="min-h-[48px] inline-flex items-center border-b border-stone-100">Pelatih</a>
          <a href="/harga" class="min-h-[48px] inline-flex items-center border-b border-stone-100">Harga</a>
          <a href="/kontak" class="min-h-[48px] inline-flex items-center border-b border-stone-100">Kontak</a>
          <a href={cta} class="mt-3 inline-flex items-center justify-center min-h-[48px] rounded-full bg-emerald-800 text-white">Tanya via DM IG</a>
        </div>
      </div>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="mt-20 bg-stone-900 text-white">
    <div class="max-w-7xl mx-auto px-4 py-12 grid gap-8 grid-cols-1 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="font-black uppercase tracking-tight text-xl">Jambi Bugar Jambi</p>
        <p class="mt-2 text-base text-white/70 leading-relaxed max-w-[65ch]">{business.address} &mdash; {business.hours}</p>
      </div>
      <div class="md:col-span-5">
        <p class="font-bold text-sm uppercase tracking-widest">Hubungi</p>
        <div class="mt-3 flex flex-col gap-2 text-sm font-medium">
          <a href={business.instagram} class="underline underline-offset-4 min-h-[48px] inline-flex items-center">Instagram @jambibugar.gym</a>
          <a href={business.mapsUrl} class="underline underline-offset-4 min-h-[48px] inline-flex items-center">Google Maps &mdash; rute ke lokasi</a>
        </div>
        <p class="mt-6 text-xs text-white/40">&copy; 2026 Jambi Bugar &mdash; Kota Jambi.</p>
      </div>
    </div>
  </footer>
</body>
</html>
