---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; }
const { title, description, canonicalPath = '/', image } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://jambibugar-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
import { business, ctaLink } from '../data/business';
const cta = ctaLink(`Halo ${business.name}, saya mau tanya jadwal sesi.`);
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} />
</head>
<body class="bg-stone-50 text-stone-900 antialiased">
  <div class="border-b border-emerald-800/15 bg-emerald-800/[0.04]">
    <p class="max-w-7xl mx-auto px-4 py-2 text-xs tracking-wide text-emerald-800">Rumah Transformasi — Nyaman, Aman, Syari &bull; Sesi Pria &amp; Muslimah terpisah</p>
  </div>
  <header class="sticky top-0 z-40 bg-stone-50/85 backdrop-blur-xl border-b border-stone-200/70">
    <nav class="max-w-7xl mx-auto flex items-center justify-between px-4 py-3">
      <a href="/" class="flex items-center gap-2.5">
        <span class="grid place-items-center w-9 h-9 rounded-2xl bg-emerald-800 text-stone-50 font-bold" aria-hidden="true">B</span>
        <span class="font-bold tracking-tight leading-none">Jambi Bugar<small class="block text-[11px] font-medium text-stone-500 tracking-wide">HOME GYM ISLAMI</small></span>
      </a>
      <div class="hidden md:flex gap-6 text-sm text-stone-600">
        <a href="/" class="hover:text-emerald-800 transition">Beranda</a>
        <a href="/program" class="hover:text-emerald-800 transition">Program</a>
        <a href="/pelatih" class="hover:text-emerald-800 transition">Pelatih</a>
        <a href="/harga" class="hover:text-emerald-800 transition">Harga</a>
        <a href="/kontak" class="hover:text-emerald-800 transition">Kontak</a>
      </div>
      <a href={cta} class="bg-emerald-800 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-500 hover:bg-emerald-900 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.22,0.61,0.21,1)">Tanya via DM IG</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="mt-20 border-t border-stone-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 py-12 grid gap-8 grid-cols-1 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="font-bold tracking-tight text-lg">Jambi Bugar Gym</p>
        <p class="mt-1 text-sm text-emerald-800 font-medium">Rumah Transformasi — Nyaman | Aman | Syari</p>
        <p class="mt-2 text-base text-stone-600 leading-relaxed max-w-[65ch]">{business.address} — {business.hours}</p>
        <p class="mt-2 text-sm text-stone-500">Jadwal sesi &amp; pendaftaran via DM Instagram. Rute via Google Maps.</p>
      </div>
      <div class="md:col-span-5">
        <p class="font-semibold text-sm">Hubungi dengan adab</p>
        <div class="mt-3 flex flex-col gap-2 text-sm">
          <a href={business.instagram} class="underline underline-offset-4 decoration-emerald-800/40">Instagram @jambibugar.gym</a>
          <a href={business.mapsUrl} class="underline underline-offset-4 decoration-emerald-800/40">Google Maps — rute ke lokasi</a>
        </div>
        <p class="mt-6 text-xs text-stone-400">© 2026 Jambi Bugar Gym — Kota Jambi.</p>
      </div>
    </div>
  </footer>
</body>
</html>
